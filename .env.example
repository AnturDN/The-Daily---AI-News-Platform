# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your own keys. The same GROQ_API_KEY and
# GEMINI_API_KEY values must ALSO be added in Vercel Project Settings ->
# Environment Variables for the deployed site's AI summaries to work.
# ---------------------------------------------------------------------------

# GNews API key from gnews.io (optional fallback wire) — used by the browser.
VITE_GNEWS_API_KEY=your_gnews_api_key_here

# Groq API key from https://console.groq.com/keys — PRIMARY summarizer,
# free ~1,000 requests/day per model, no credit card.
GROQ_API_KEY=your_groq_api_key_here

# GROQ_MODEL is OPTIONAL: the app keeps its own model ladder
# (gpt-oss-120b -> gpt-oss-20b -> qwen3.8-27b) and walks down it whenever a
# model is retired or its daily quota is spent. Leave it unset.
# GROQ_MODEL=

# Gemini API key from https://aistudio.google.com — FALLBACK summarizer.
# Flash models ~20 requests/day each, Gemma models ~1,500/day.
GEMINI_API_KEY=your_gemini_api_key_here

# GEMINI_MODEL is OPTIONAL — the ladder covers per-model quotas.
# GEMINI_MODEL=
